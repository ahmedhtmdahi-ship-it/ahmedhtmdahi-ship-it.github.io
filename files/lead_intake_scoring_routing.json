    {
      "parameters": {
        "content": "## Lead intake & routing\n1. Form posts to /new-lead\n2. Fields cleaned, contact validated\n3. Duplicate check by email in Google Sheets\n4. Lead scored 0-100 → hot / warm / cold\n5. Hot leads ping sales on Telegram\n6. Every lead logged in the CRM sheet + auto-reply\n\nReplace REPLACE_WITH_SHEET_ID and REPLACE_WITH_CHAT_ID, then connect Google, Gmail and Telegram credentials.",
        "height": 300,
        "width": 420
      },
      "id": "84ceaccc-e584-4c35-8ea4-545964e5c24f",
      "name": "Sticky: How it works",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -120
      ]
    }
